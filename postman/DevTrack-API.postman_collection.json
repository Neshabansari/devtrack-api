{
  "info": {
    "name": "DevTrack API",
    "description": "Task 2 - Users, Projects & Tasks REST API for the DevTrack platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Users",
      "item": [
        { "name": "List users", "request": { "method": "GET", "url": "{{baseUrl}}/users" } },
        { "name": "Get user by id", "request": { "method": "GET", "url": "{{baseUrl}}/users/u1" } },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Lee\",\n  \"role\": \"Frontend Engineer\",\n  \"email\": \"jordan.lee@devtrack.dev\"\n}"
            }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/u1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"Senior Java Developer\"\n}" }
          }
        },
        { "name": "Delete user", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/u1" } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        { "name": "List projects", "request": { "method": "GET", "url": "{{baseUrl}}/projects" } },
        {
          "name": "List projects (filter by status)",
          "request": { "method": "GET", "url": "{{baseUrl}}/projects?status=active" }
        },
        { "name": "Get project by id", "request": { "method": "GET", "url": "{{baseUrl}}/projects/p1" } },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"MOB\",\n  \"name\": \"Mobile App Revamp\",\n  \"description\": \"Rebuild the mobile app on the new design system.\",\n  \"status\": \"planning\",\n  \"dueDate\": \"2026-12-01\",\n  \"memberIds\": [\"u1\"]\n}"
            }
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/projects/p1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"progress\": 75\n}" }
          }
        },
        { "name": "Delete project", "request": { "method": "DELETE", "url": "{{baseUrl}}/projects/p1" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        { "name": "List tasks", "request": { "method": "GET", "url": "{{baseUrl}}/tasks" } },
        {
          "name": "List tasks (filters)",
          "request": { "method": "GET", "url": "{{baseUrl}}/tasks?status=todo&priority=high&search=gateway" }
        },
        { "name": "Get task by id", "request": { "method": "GET", "url": "{{baseUrl}}/tasks/t1" } },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write integration tests for the gateway\",\n  \"projectId\": \"p1\",\n  \"priority\": \"high\",\n  \"assigneeId\": \"u1\",\n  \"dueDate\": \"2026-09-20\"\n}"
            }
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tasks/t1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"urgent\"\n}" }
          }
        },
        {
          "name": "Update task status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/tasks/t1/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" }
          }
        },
        { "name": "Delete task", "request": { "method": "DELETE", "url": "{{baseUrl}}/tasks/t1" } }
      ]
    }
  ]
}
